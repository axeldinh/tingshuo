{
  "name": "tingshuo",
  "version": "1.0.0",
  "description": "Mandarin listening & speaking trainer (HSK 1-3)",
  "main": "index.js",
  "scripts": {
    "build": "node tools/build-data.js && node tools/stamp-sw.js",
    "test": "node test/unit.js && node test/speech-eval.js && node test/tone-eval.js --check && node test/word-eval.js --check && node test/compat.js",
    "serve": "cd docs && python3 -m http.server 8000",
    "coverage": "node tools/coverage.js",
    "check:sw": "node tools/stamp-sw.js --check",
    "test:e2e": "node test/e2e-upgrade.js",
    "check:items": "node tools/released-items.js",
    "verify": "npm test && npm run check:sw && node tools/released-items.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "pinyin-pro": "^3.29.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
